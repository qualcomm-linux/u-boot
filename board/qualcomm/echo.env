# Same as default.env, plus Vol-Down/Alpaca "Boot to fastboot" (button_cmd_0)
# and recovery boot from the "recovery" partition (preboot/recovery_boot)
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=if test "${reboot-mode}" = "bootloader"; then run fastboot; elif test "${reboot-mode}" = "recovery"; then run recovery_boot; fi
recovery_boot=part number mmc 0 recovery rpart && setenv devtype mmc && setenv devnum 0 && setenv distro_bootpart ${rpart} && load mmc 0:${rpart} ${scriptaddr} boot.scr && source ${scriptaddr}
fastboot=fastboot -l $fastboot_addr_r usb 0
do_boot=bootflow scan -lb
bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Reset device=reset
menucmd=bootmenu
bootcmd=run do_boot
button_cmd_0_name=Volume Down
button_cmd_0=run fastboot
