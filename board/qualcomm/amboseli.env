stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=if test "${reboot-mode}" = "bootloader"; then run fastboot; fi
fastboot=fastboot -l $fastboot_addr_r usb 0

# Amboseli's kernel FIT (per-board config selection via
# board_fit_config_name_match(), see docs/fit-config-selection-design.md)
# lives on a FAT partition that bootflow scan's automatic discovery never
# reaches: cmd/bootflow.c always
# sets BOOTFLOWIF_ONLY_BOOTABLE, and boot/bootdev-uclass.c's
# bootdev_find_in_blk() then skips every partition except the GPT
# legacy_bios_bootable one (or partition 1, if none is flagged) - silently
# excluding this partition on an unattended boot even though it's reachable
# directly (e.g. a manual `fatload mmc 0:23 ...`). Run amboseli-boot.scr's
# logic directly instead of relying on that discovery; fall back to
# bootflow scan if the known partition isn't present.
do_boot=if load mmc 0:23 ${scriptaddr} boot.scr; then setenv devtype mmc; setenv devnum 0; setenv distro_bootpart 23; setenv prefix /; source ${scriptaddr}; else bootflow scan -lb; fi
bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Reset device=reset
menucmd=bootmenu
bootcmd=run do_boot
