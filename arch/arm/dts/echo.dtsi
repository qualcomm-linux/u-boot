	cti@11013000 {
		compatible = "arm,coresight-cti", "arm,primecell";
		reg = <0x0 0x11013000 0x0 0x1000>;
		device-name = "cti_mss_1";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
