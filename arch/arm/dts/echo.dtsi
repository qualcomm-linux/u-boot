			     <GIC_SPI 207 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "msi0", "msi1", "msi2", "msi3",
				  "msi4", "msi5", "msi6", "msi7";

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &intc GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 2 &intc GIC_SPI 221 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 3 &intc GIC_SPI 222 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 4 &intc GIC_SPI 223 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&gcc GCC_PCIE_1_AUX_CLK>,
			<&gcc GCC_PCIE_1_CFG_AHB_CLK>,
			<&gcc GCC_PCIE_1_MSTR_AXI_CLK>,
			<&gcc GCC_PCIE_1_SLV_AXI_CLK>,
			<&gcc GCC_PCIE_1_SLV_Q2A_AXI_CLK>;

		clock-names = "aux",
			      "cfg",
			      "bus_master",
			      "bus_slave",
			      "slave_q2a";

		assigned-clocks = <&gcc GCC_PCIE_1_AUX_CLK>;
		assigned-clock-rates = <19200000>;

		interconnects = <&pcie_noc MASTER_PCIE_1 QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				 &system_noc SLAVE_PCIE_1 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "pcie-mem",
				     "cpu-pcie";

		resets = <&gcc GCC_PCIE_1_BCR>;
		reset-names = "pci";

		power-domains = <&gcc GCC_PCIE_1_GDSC>;

		phys = <&pcie1_phy>;
		phy-names = "pciephy";

		perst-gpios = <&tlmm 125 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pcie1_default_state>;

		iommu-map = <0x0 &apps_smmu 0x880 0x1>,
			    <0x100 &apps_smmu 0x881 0x1>;

		status = "disabled";

		pcie1_port0: pcie@0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				bus-range = <0x01 0xff>;
				wake-gpios = <&tlmm 123 GPIO_ACTIVE_HIGH>;

				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
		};
	};

	pcie1_phy: phy@1b18000 {
		compatible = "qcom,echo-qmp-gen4x2-pcie-phy";
		reg = <0x0 0x01b18000 0x0 0x2000>;

		clocks = <&gcc GCC_PCIE_1_CFG_AHB_CLK>,
			 <&tcsrcc TCSR_PCIE_2L_CLKREF_EN>,
			 <&gcc GCC_PCIE_1_PHY_RCHNG_CLK>,
			 <&gcc GCC_PCIE_1_PIPE_CLK>,
			 <&gcc GCC_PCIE_1_PIPE_DIV2_CLK>,
			 <&gcc GCC_PCIE_1_PHY_AUX_CLK>;

		clock-names = "cfg_ahb",
			      "ref",
			      "rchng",
			      "pipe",
			      "pipediv2",
			      "phy_aux";

		assigned-clocks = <&gcc GCC_PCIE_1_PHY_RCHNG_CLK>;
		assigned-clock-rates = <100000000>;

		power-domains = <&gcc GCC_PCIE_1_PHY_GDSC>;

		vdda-phy-supply = <&vreg_l4b_0p8>;
		vdda-pll-supply = <&vreg_l1b_1p2>;

		resets = <&gcc GCC_PCIE_1_PHY_BCR>,
			 <&gcc GCC_PCIE_1_NOCSR_COM_PHY_BCR>;
		reset-names = "phy",
			      "phy_nocsr";

		#clock-cells = <0>;
		clock-output-names = "pcie_1_pipe_clk";

		#phy-cells = <0>;

		status = "disabled";
	};

	pcie2: qcom,pcie@1b20000 {
		compatible = "qcom,pcie-echo", "qcom,pcie-sdx55";
		reg = <0x0 0x01b20000 0x0 0x4000>,
		      <0x0 0x60000000 0x0 0xf20>,
		      <0x0 0x60000f40 0x0 0xa8>,
		      <0x0 0x60001000 0x0 0x4000>,
		      <0x0 0x60100000 0x0 0x100000>,
		      <0x0 0x01b25000 0x0 0x1000>;
		reg-names = "parf", "dbi", "elbi", "atu", "config", "mhi";
		device_type = "pci";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x01000000 0x0 0x00000000 0x0 0x60200000 0x0 0x100000>,
			 <0x02000000 0x0 0x60300000 0x0 0x60300000 0x0 0x1d00000>;
		bus-range = <0x00 0xff>;

		dma-coherent;

		linux,pci-domain = <2>;
		num-lanes = <1>;

		interrupts = <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 229 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 230 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 231 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 232 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 234 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 235 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "msi0", "msi1", "msi2", "msi3",
				  "msi4", "msi5", "msi6", "msi7";

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &intc GIC_SPI 236 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 2 &intc GIC_SPI 237 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 3 &intc GIC_SPI 238 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 4 &intc GIC_SPI 239 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&gcc GCC_PCIE_2_AUX_CLK>,
			<&gcc GCC_PCIE_2_CFG_AHB_CLK>,
			<&gcc GCC_PCIE_2_MSTR_AXI_CLK>,
			<&gcc GCC_PCIE_2_SLV_AXI_CLK>,
			<&gcc GCC_PCIE_2_SLV_Q2A_AXI_CLK>;

		clock-names = "aux",
			      "cfg",
			      "bus_master",
			      "bus_slave",
			      "slave_q2a";

		assigned-clocks = <&gcc GCC_PCIE_2_AUX_CLK>;
		assigned-clock-rates = <19200000>;

		interconnects = <&pcie_noc MASTER_PCIE_2 QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				 &system_noc SLAVE_PCIE_2 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "pcie-mem",
				     "cpu-pcie";

		resets = <&gcc GCC_PCIE_2_BCR>;
		reset-names = "pci";

		power-domains = <&gcc GCC_PCIE_2_GDSC>;

		phys = <&pcie2_phy>;
		phy-names = "pciephy";

		perst-gpios = <&tlmm 122 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pcie2_default_state>;

		iommu-map = <0x0 &apps_smmu 0x900 0x1>,
			    <0x100 &apps_smmu 0x901 0x1>;

		status = "disabled";

		pcie2_port0: pcie@0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				bus-range = <0x01 0xff>;
				wake-gpios = <&tlmm 120 GPIO_ACTIVE_HIGH>;

				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
		};
	};

	pcie2_phy: phy@1b28000 {
		compatible = "qcom,echo-qmp-gen4x1-pcie-phy";
		reg = <0x0 0x01b28000 0x0 0x2000>;

		clocks = <&gcc GCC_PCIE_2_CFG_AHB_CLK>,
			 <&tcsrcc TCSR_PCIE_1L_CLKREF_EN>,
			 <&gcc GCC_PCIE_2_PHY_RCHNG_CLK>,
			 <&gcc GCC_PCIE_2_PIPE_CLK>,
			 <&gcc GCC_PCIE_2_PIPE_DIV2_CLK>,
			 <&gcc GCC_PCIE_2_PHY_AUX_CLK>;

		clock-names = "cfg_ahb",
			      "ref",
			      "rchng",
			      "pipe",
			      "pipediv2",
			      "phy_aux";

		assigned-clocks = <&gcc GCC_PCIE_2_PHY_RCHNG_CLK>;
		assigned-clock-rates = <100000000>;

		power-domains = <&gcc GCC_PCIE_2_PHY_GDSC>;

		vdda-phy-supply = <&vreg_l4b_0p8>;
		vdda-pll-supply = <&vreg_l1b_1p2>;

		resets = <&gcc GCC_PCIE_2_PHY_BCR>,
			 <&gcc GCC_PCIE_2_NOCSR_COM_PHY_BCR>;
		reset-names = "phy",
			      "phy_nocsr";

		#clock-cells = <0>;
		clock-output-names = "pcie_2_pipe_clk";

		#phy-cells = <0>;

		status = "disabled";
	};

	pcie3: qcom,pcie@1b30000 {
		compatible = "qcom,pcie-echo", "qcom,pcie-sdx55";
		reg = <0x0 0x01b30000 0x0 0x4000>,
		      <0x0 0x70000000 0x0 0xf20>,
		      <0x0 0x70000f40 0x0 0xa8>,
		      <0x0 0x70001000 0x0 0x4000>,
		      <0x0 0x70100000 0x0 0x100000>,
		      <0x0 0x01b35000 0x0 0x1000>;
		reg-names = "parf", "dbi", "elbi", "atu", "config", "mhi";
		device_type = "pci";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x01000000 0x0 0x00000000 0x0 0x70200000 0x0 0x100000>,
			 <0x02000000 0x0 0x70300000 0x0 0x70300000 0x0 0x1d00000>;
		bus-range = <0x00 0xff>;

		dma-coherent;

		linux,pci-domain = <3>;
		num-lanes = <1>;

		interrupts = <GIC_SPI 659 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 658 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 657 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 656 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 655 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 654 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 653 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 652 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "msi0", "msi1", "msi2", "msi3",
				  "msi4", "msi5", "msi6", "msi7";

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &intc GIC_SPI 651 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 2 &intc GIC_SPI 650 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 3 &intc GIC_SPI 649 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 4 &intc GIC_SPI 648 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&gcc GCC_PCIE_3_AUX_CLK>,
			<&gcc GCC_PCIE_3_CFG_AHB_CLK>,
			<&gcc GCC_PCIE_3_MSTR_AXI_CLK>,
			<&gcc GCC_PCIE_3_SLV_AXI_CLK>,
			<&gcc GCC_PCIE_3_SLV_Q2A_AXI_CLK>;

		clock-names = "aux",
			      "cfg",
			      "bus_master",
			      "bus_slave",
			      "slave_q2a";

		assigned-clocks = <&gcc GCC_PCIE_3_AUX_CLK>;
		assigned-clock-rates = <19200000>;

		interconnects = <&pcie_noc MASTER_PCIE_3 QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				 &system_noc SLAVE_PCIE_3 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "pcie-mem",
				     "cpu-pcie";

		resets = <&gcc GCC_PCIE_3_BCR>;
		reset-names = "pci";

		power-domains = <&gcc GCC_PCIE_3_GDSC>;

		phys = <&pcie3_phy>;
		phy-names = "pciephy";

		perst-gpios = <&tlmm 105 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pcie3_default_state>;

		iommu-map = <0x0 &apps_smmu 0x980 0x1>,
			    <0x100 &apps_smmu 0x981 0x1>;

		status = "disabled";

		pcie3_port0: pcie@0 {
			device_type = "pci";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			bus-range = <0x01 0xff>;
			wake-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
		};
	};

	pcie3_phy: phy@1b38000 {
		compatible = "qcom,echo-qmp-gen4x1-pcie-phy";
		reg = <0x0 0x01b38000 0x0 0x2000>;

		clocks = <&gcc GCC_PCIE_3_CFG_AHB_CLK>,
			 <&tcsrcc TCSR_PCIE_1L_B_CLKREF_EN>,
			 <&gcc GCC_PCIE_3_PHY_RCHNG_CLK>,
			 <&gcc GCC_PCIE_3_PIPE_CLK>,
			 <&gcc GCC_PCIE_3_PIPE_DIV2_CLK>,
			 <&gcc GCC_PCIE_3_PHY_AUX_CLK>;

		clock-names = "cfg_ahb",
			      "ref",
			      "rchng",
			      "pipe",
			      "pipediv2",
			      "phy_aux";

		assigned-clocks = <&gcc GCC_PCIE_3_PHY_RCHNG_CLK>;
		assigned-clock-rates = <100000000>;

		power-domains = <&gcc GCC_PCIE_3_PHY_GDSC>;

		vdda-phy-supply = <&vreg_l4b_0p8>;
		vdda-pll-supply = <&vreg_l1b_1p2>;

		resets = <&gcc GCC_PCIE_3_PHY_BCR>,
			 <&gcc GCC_PCIE_3_NOCSR_COM_PHY_BCR>;
		reset-names = "phy",
			      "phy_nocsr";

		#clock-cells = <0>;
		clock-output-names = "pcie_3_pipe_clk";

		#phy-cells = <0>;

		status = "disabled";
	};

	pcie0_ep: qcom,pcie@0x40000000 {
		compatible = "qcom,echo-pcie-ep";
		reg = <0x0 0x01b00000 0x0 0x4000>,
			<0x0 0x40000000 0x0 0xf20>,
			<0x0 0x40000f40 0x0 0xa8>,
			<0x0 0x01b05000 0x0 0x1000>,
			<0x0 0x40001000 0x0 0x4000>,
			/* Start after iATU OB window 0 (2 MB) reserved by PBL; target-specific */
			<0x0 0x40300000 0x0 0x1FF00000>,
			<0x0 0x40020000 0x0 0x8000>,
			/* AOSS_CC_PERST_STATUS; target-specific */
			<0x0 0x0C2FB000 0x0 0x4>;
		reg-names = "parf", "dbi", "elbi", "mmio",
			"atu", "addr_space", "msix", "aoss_perst_status";

		interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "global", "doorbell";

		pinctrl-names = "default";
		pinctrl-0 = <&pcie0_default_state>;

		wake-gpio = <&tlmm 42 GPIO_ACTIVE_LOW>;
		clkreq-gpio = <&tlmm 43 GPIO_ACTIVE_LOW>;
		reset-gpio = <&tlmm 44 GPIO_ACTIVE_LOW>;

		clocks = <&gcc GCC_PCIE_AUX_CLK>,
			 <&gcc GCC_PCIE_CFG_AHB_CLK>,
			 <&gcc GCC_PCIE_MSTR_AXI_CLK>,
			 <&gcc GCC_PCIE_SLV_AXI_CLK>,
			 <&gcc GCC_PCIE_SLV_Q2A_AXI_CLK>;

		clock-names = "aux",
			      "cfg",
			      "bus_master",
			      "bus_slave",
			      "slave_q2a";

		resets = <&gcc GCC_PCIE_BCR>;
		reset-names = "core";

		power-domains = <&gcc GCC_PCIE_GDSC>;

		phys = <&pcie0_phy>;
		phy-names = "pciephy";

		num-lanes = <2>;

		status = "disabled";
	};

};

&firmware {
	qcom_scm: qcom_scm {
		compatible = "qcom,scm";
		qcom,dload-mode = <&tcsr 0x19000>;
		interconnects = <&system_noc MASTER_CRYPTO 0 &mc_virt SLAVE_EBI1 0>;
		sram = <&minidump_config>;
	};

	qcom_mem_object {
		compatible = "qcom,mem-object";
	};

	qcom_smcinvoke {
		compatible = "qcom,smcinvoke";
	};
};

#include "echo-dma-heaps.dtsi"
#include "ipcc-test-echo.dtsi"
#include "pmk8550.dtsi"
#include "pmx75.dtsi"
#include "echo-eth.dtsi"

&uart1 {
	status = "ok";
};

&pmx75_eusb2_repeater {
	vdd18-supply = <&vreg_l5b_1p7>;
	vdd3-supply = <&vreg_l10b_3p0>;
	status = "ok";
};

&usb_hsphy {
	phys = <&pmx75_eusb2_repeater>;
};

&pmx75_vbus_detect {
	status = "ok";
};

&usb {
	extcon = <&pmx75_vbus_detect>, <&eud>;
};

&spmi_bus {
	pmg1110: pmic@a {
		compatible = "qcom,pmg1110", "qcom,spmi-pmic";
		reg = <10 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		pmg1110_temp_alarm: temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0xa 0xa 0x0 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0>;
		};
	};
};

&pon_pwrkey {
	status = "ok";
};

&pon_resin {
	status = "ok";
};

#include "echo-thermal.dtsi"

&pmx75_temp_alarm {
	io-channels = <&pmk8550_adc PMX75_ADC5_GEN3_DIE_TEMP>;
	io-channel-names = "thermal";
};

&pmk8550_adc {
	status = "ok";

	pmk8550_xo_therm {
		reg = <PMK8550_ADC5_GEN3_AMUX_THM1_XO_THERM_100K_PU>;
		label = "pmk8550_xo_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <700>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	/* PMX75 Channel nodes */
	pmx75_offset_ref {
		reg = <PMX75_ADC5_GEN3_OFFSET_REF>;
		label = "pmx75_offset_ref";
		qcom,pre-scaling = <1 1>;
	};

	pmx75_vref_1p25 {
		reg = <PMX75_ADC5_GEN3_1P25VREF>;
		label = "pmx75_vref_1p25";
		qcom,pre-scaling = <1 1>;
	};

	pmx75_die_temp {
		reg = <PMX75_ADC5_GEN3_DIE_TEMP>;
		label = "pmx75_die_temp";
		qcom,pre-scaling = <1 1>;
	};

	pmx75_vph_pwr {
		reg = <PMX75_ADC5_GEN3_VPH_PWR>;
		label = "pmx75_vph_pwr";
		qcom,pre-scaling = <1 3>;
	};

	pmx75_pa_therm1 {
		reg = <PMX75_ADC5_GEN3_AMUX_THM1_100K_PU>;
		label = "pmx75_pa_therm1";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	pmx75_pa_therm2 {
		reg = <PMX75_ADC5_GEN3_AMUX_THM2_100K_PU>;
		label = "pmx75_pa_therm2";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	pmx75_sdx_case_therm {
		reg = <PMX75_ADC5_GEN3_AMUX_THM3_100K_PU>;
		label = "pmx75_sdx_case_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	pmx75_ambient_therm {
		reg = <PMX75_ADC5_GEN3_AMUX_THM4_100K_PU>;
		label = "pmx75_ambient_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	pmx75_qtm_therm: pmx75_qtm_therm {
		reg = <PMX75_ADC5_GEN3_AMUX_THM5_100K_PU>;
		label = "pmx75_qtm_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	pmx75_sdr_skin_therm: pmx75_sdr_skin_therm {
		reg = <PMX75_ADC5_GEN3_AMUX_THM6_100K_PU>;
		label = "pmx75_sdr_skin_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	pmiv0102_offset_ref {
		reg = <PMIV0104_ADC5_GEN3_OFFSET_REF>;
		label = "pmiv0102_offset_ref";
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};

	pmiv0102_vref_1p25 {
		reg = <PMIV0104_ADC5_GEN3_1P25VREF>;
		label = "pmiv0102_vref_1p25";
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};

	pmiv0102_die_temp {
		reg = <PMIV0104_ADC5_GEN3_DIE_TEMP>;
		label = "pmiv0102_die_temp";
		qcom,pre-scaling = <1 1>;
		status = "disabled";
	};

	pmiv0102_vph_pwr {
		reg = <PMIV0104_ADC5_GEN3_VPH_PWR>;
		label = "pmiv0102_vph_pwr";
		qcom,pre-scaling = <1 3>;
		status = "disabled";
	};
};

/ {
	thermal-zones {
		pmg1110-thermal {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&pmg1110_temp_alarm>;
			status = "disabled";

			trips {
				trip0 {
					temperature = <95000>;
					hysteresis = <0>;
					type = "passive";
				};

				trip1 {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};

				trip2 {
					temperature = <145000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
