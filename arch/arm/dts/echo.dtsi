		reg = <0x0 0x11005000 0x0 0x1000>;
		device-name = "cti_modem";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";
		qcom,extended_cti;
	};

	tpda@11006000 {
		compatible = "qcom,coresight-tpda", "arm,primecell";
		reg = <0x0 0x11006000 0x0 0x1000>;
		device-name = "tpda_modem";

		clocks = <&aoss_qmp>;
		clock-names = "apb_pclk";

		in-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				modem_tpda_in0: endpoint {
					remote-endpoint = <&modem_tpdm_out>;
				};
			};

			port@1 {
				reg = <1>;

				modem_tpda_in1: endpoint {
					remote-endpoint = <&cesta_tpdm_out>;
				};
			};

			port@2 {
				reg = <2>;

				modem_tpda_in2: endpoint {
					remote-endpoint = <&gdpm_tpdm_out>;
				};
			};

			port@3 {
				reg = <3>;

				modem_tpda_in3: endpoint {
					remote-endpoint = <&modem3_tpdm_out>;
