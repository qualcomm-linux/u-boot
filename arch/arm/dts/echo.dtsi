			interconnects = <&clk_virt MASTER_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS
					 &clk_virt SLAVE_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS>,
					<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
					 &system_noc SLAVE_QUP_0 QCOM_ICC_TAG_ALWAYS>;
			interconnect-names = "qup-core",
					     "qup-config";
			dmas = <&gpi_dma0 0 9 QCOM_GPI_SPI>,
			       <&gpi_dma0 1 9 QCOM_GPI_SPI>;
			dma-names = "tx",
				    "rx";
			pinctrl-0 = <&qup_spi9_miso_mira>, <&qup_spi9_mosi_mira>,
				    <&qup_spi9_clk_mira>, <&qup_spi9_cs_mira>;
			pinctrl-1 = <&qup_spi9_sleep_mira>;
			pinctrl-names = "default", "sleep";
