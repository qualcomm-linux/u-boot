		ranges = <0x01000000 0x0 0x00000000 0x0 0x50200000 0x0 0x100000>,
			 <0x02000000 0x0 0x50300000 0x0 0x50300000 0x0 0x1d00000>;
		bus-range = <0x00 0xff>;

		dma-coherent;

		linux,pci-domain = <1>;
