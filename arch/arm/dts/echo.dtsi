	apsscc: syscon@17a80000 {
		compatible = "syscon";
		reg = <0x0 0x17aa0000 0x0 0x1c>;
	};

	mccc: syscon@300ba000 {
		compatible = "syscon";
		reg = <0x0 0x300ba000 0x0 0x54>;
	};

	debugcc: clock-controller@0 {
		compatible = "qcom,echo-debugcc";
		qcom,apsscc = <&apsscc>;
		qcom,gcc = <&gcc>;
		qcom,mccc = <&mccc>;
		clocks = <&rpmhcc RPMH_CXO_CLK>,
			 <&gcc 0>;
		clock-names = "xo_clk_src",
			      "gcc";
		#clock-cells = <1>;
	};

	cpufreq_hw: cpufreq@17d91000 {
		compatible = "qcom,echo-cpufreq-epss", "qcom,cpufreq-epss";
		reg = <0x0 0x17d91000 0x0 0x1000>,
		      <0x0 0x17d92000 0x0 0x1000>;
		reg-names = "freq-domain0",
			    "freq-domain1";

		interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dcvsh-irq-0",
				  "dcvsh-irq-1";

		clocks = <&rpmhcc RPMH_CXO_CLK>, <&gcc GCC_GPLL0>;
		clock-names = "xo", "alternate";

		#freq-domain-cells = <1>;
	};

	qcom,cpufreq-hw-debug@0 {
		compatible = "qcom,cpufreq-hw-epss-debug";
		qcom,freq-hw-domain = <&cpufreq_hw 0>, <&cpufreq_hw 1>;
	};

	llcc_device: cache-controller@30800000 {
		compatible = "qcom,echo-llcc";
		reg = <0x0 0x30800000 0x0 0x200000>, <0x0 0x30C00000 0x0 0x200000>,
			<0x0 0x31000000 0x0 0x200000>, <0x0 0x31400000 0x0 0x200000>;
		reg-names = "llcc0_base", "llcc1_base",
			"llcc_broadcast_or_base", "llcc_broadcast_and_base";
		interrupts = <GIC_SPI 399 IRQ_TYPE_LEVEL_HIGH>;
		cap-based-alloc-and-pwr-collapse;
		memory-region = <&llcc_tcm_mem>;
	};

	qcom,sps {
		compatible = "qcom,msm-sps-4k";
		qcom,pipe-attr-ee;
	};

	qnand_1: nand@1C20000 {
		compatible = "qcom,msm-nand";
		reg =	<0x0 0x01C20000 0x0 0x1000>,
			<0x0 0x01C24000 0x0 0x1C000>;
		reg-names =	"nand_phys",
				"bam_phys";
		qcom,reg-adjustment-offset = <0x4000>;

		interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "bam_irq";

		clock-names = "core_clk";
		clocks = <&rpmhcc RPMH_QPIC_CLK>;

		interconnects = <&system_noc MASTER_QPIC QCOM_ICC_TAG_ALWAYS
			&mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "nand-ddr";
		qcom,msm-bus,name = "qpic_nand";
		qcom,msm-bus,num-cases = <2>;
		qcom,msm-bus,num-paths = <1>;
		qcom,msm-bus,vectors-KBps =
			<0 0>,
		/* Voting for max b/w on PNOC bus for 100MHz clk rate */
			<1057800 725760>;

		iommus = <&apps_smmu 0x120 0x3>;
		qcom,iommu-dma = "atomic";
		dma-coherent;

		qcom,qpic-nand-v2-1-4;
		qcom,boost_mode;

		status = "disabled";
	};

	pcie0: qcom,pcie@1b00000 {
		compatible = "qcom,pcie-echo", "qcom,pcie-sdx55";
		reg = <0x0 0x01b00000 0x0 0x4000>,
		      <0x0 0x40000000 0x0 0xf20>,
		      <0x0 0x40000f40 0x0 0xa8>,
		      <0x0 0x40001000 0x0 0x4000>,
		      <0x0 0x40100000 0x0 0x100000>,
		      <0x0 0x01b05000 0x0 0x1000>;
		reg-names = "parf", "dbi", "elbi", "atu", "config", "mhi";
		device_type = "pci";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x01000000 0x0 0x00000000 0x0 0x40200000 0x0 0x100000>,
			 <0x02000000 0x0 0x40300000 0x0 0x40300000 0x0 0x1d00000>;
		bus-range = <0x00 0xff>;

		dma-coherent;

		linux,pci-domain = <0>;
		num-lanes = <2>;

		interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 124 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "msi0", "msi1", "msi2", "msi3",
				  "msi4", "msi5", "msi6", "msi7";

		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &intc GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 2 &intc GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 3 &intc GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
				<0 0 0 4 &intc GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&gcc GCC_PCIE_AUX_CLK>,
			<&gcc GCC_PCIE_CFG_AHB_CLK>,
			<&gcc GCC_PCIE_MSTR_AXI_CLK>,
			<&gcc GCC_PCIE_SLV_AXI_CLK>,
			<&gcc GCC_PCIE_SLV_Q2A_AXI_CLK>;

		clock-names = "aux",
			      "cfg",
			      "bus_master",
			      "bus_slave",
			      "slave_q2a";

		assigned-clocks = <&gcc GCC_PCIE_AUX_CLK>;
		assigned-clock-rates = <19200000>;

		interconnects = <&pcie_noc MASTER_PCIE_0 QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				 &system_noc SLAVE_PCIE_0 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "pcie-mem",
				     "cpu-pcie";

		resets = <&gcc GCC_PCIE_BCR>;
		reset-names = "pci";

		power-domains = <&gcc GCC_PCIE_GDSC>;

		phys = <&pcie0_phy>;
		phy-names = "pciephy";

		perst-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pcie0_default_state>;

		iommu-map = <0x0 &apps_smmu 0x800 0x1>,
			    <0x100 &apps_smmu 0x801 0x1>;

		status = "disabled";

		pcie0_port0: pcie@0 {
				device_type = "pci";
				reg = <0x0 0x0 0x0 0x0 0x0>;
				bus-range = <0x01 0xff>;
				wake-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;

				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
		};
	};

	pcie0_phy: phy@1b08000 {
		compatible = "qcom,echo-qmp-gen4x2-sriov-pcie-phy";
		reg = <0x0 0x01b08000 0x0 0x2000>;

		clocks = <&gcc GCC_PCIE_CFG_AHB_CLK>,
			 <&tcsrcc TCSR_PCIE_2L_SRIOV_CLKREF_EN>,
			 <&gcc GCC_PCIE_RCHNG_PHY_CLK>,
			 <&gcc GCC_PCIE_PIPE_CLK>,
			 <&gcc GCC_PCIE_PHY_AUX_CLK>;

		clock-names = "cfg_ahb",
			      "ref",
			      "rchng",
			      "pipe",
			      "phy_aux";

		assigned-clocks = <&gcc GCC_PCIE_RCHNG_PHY_CLK>;
		assigned-clock-rates = <100000000>;

		power-domains = <&gcc GCC_PCIE_PHY_GDSC>;

		vdda-phy-supply = <&vreg_l4b_0p8>;
		vdda-pll-supply = <&vreg_l1b_1p2>;

		resets = <&gcc GCC_PCIE_PHY_BCR>,
			 <&gcc GCC_PCIE_PHY_NOCSR_COM_PHY_BCR>;
		reset-names = "phy",
			      "phy_nocsr";

		#clock-cells = <1>;
		clock-output-names = "pcie_pipe_clk";

		#phy-cells = <0>;

		status = "disabled";
	};

	pcie1: qcom,pcie@1b10000 {
		compatible = "qcom,pcie-echo", "qcom,pcie-sdx55";
		reg = <0x0 0x01b10000 0x0 0x4000>,
		      <0x0 0x50000000 0x0 0xf20>,
		      <0x0 0x50000f40 0x0 0xa8>,
		      <0x0 0x50001000 0x0 0x4000>,
		      <0x0 0x50100000 0x0 0x100000>,
		      <0x0 0x01b15000 0x0 0x1000>;
		reg-names = "parf", "dbi", "elbi", "atu", "config", "mhi";
		device_type = "pci";

		#address-cells = <3>;
