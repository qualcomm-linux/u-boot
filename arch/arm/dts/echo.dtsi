			pinctrl-1 = <&qup_uart8_sleep_tx_mirb>, <&qup_uart8_sleep_rx_mirb>;
			pinctrl-names = "default", "sleep";
			status = "disabled";
		};

		i2c9_mira: i2c-mira@aa4000 {
			compatible = "qcom,geni-i2c";
			reg = <0x0 0x00aa4000 0x0 0x4000>;
			interrupts = <GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&gcc GCC_QUPV3_WRAP0_S9_CLK>;
			clock-names = "se";
			interconnects = <&clk_virt MASTER_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS
					 &clk_virt SLAVE_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS>,
					<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
					 &system_noc SLAVE_QUP_0 QCOM_ICC_TAG_ALWAYS>,
					<&system_noc MASTER_QUP_0 QCOM_ICC_TAG_ALWAYS
					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
			interconnect-names = "qup-core",
					     "qup-config",
					     "qup-memory";
			dmas = <&gpi_dma0 0 9 QCOM_GPI_I2C>,
			       <&gpi_dma0 1 9 QCOM_GPI_I2C>;
			dma-names = "tx",
				    "rx";
			pinctrl-0 = <&qup_i2c9_data_mira>, <&qup_i2c9_clk_mira>;
			pinctrl-1 = <&qup_i2c9_sleep_mira>;
			pinctrl-names = "default", "sleep";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		spi9_mira: spi-mira@aa4000 {
			compatible = "qcom,geni-spi";
			reg = <0x0 0x00aa4000 0x0 0x4000>;
			interrupts = <GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&gcc GCC_QUPV3_WRAP0_S9_CLK>;
