	clk_virt: interconnect-clk-virt {
		compatible = "qcom,echo-clk-virt";
		#interconnect-cells = <2>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
		clocks = <&rpmhcc RPMH_QPIC_CLK>;
	};

	gem_noc: interconnect@30100000 {
		compatible = "qcom,echo-gem-noc";
		reg = <0x0 0x30100000 0x0 0x67080>;
		#interconnect-cells = <2>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	mc_virt: interconnect-mc-virt {
		compatible = "qcom,echo-mc-virt";
		#interconnect-cells = <2>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	pcie_noc: interconnect@1780000 {
		compatible = "qcom,echo-pcie-system-noc";
		reg = <0x0 0x01780000 0x0 0x15400>;
		#interconnect-cells = <2>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	system_noc: interconnect@1900000 {
		compatible = "qcom,echo-system-noc";
		reg = <0x0 0x01900000 0x0 0xac080>;
		#interconnect-cells = <2>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
		clocks = <&gcc GCC_SYS_NOC_MVMSS_CLK>;
	};

	nsp_noc: interconnect@260c0000 {
		compatible = "qcom,echo-nsp-noc";
		reg = <0x0 0x260c0000 0x0 0x1c080>;
		#interconnect-cells = <2>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	epss_l3: interconnect@17d90000 {
		compatible = "qcom,echo-epss-l3", "qcom,epss-l3";
		reg = <0x0 0x17d90000 0x0 0x1000>;
		clocks = <&rpmhcc RPMH_CXO_CLK>,
			 <&gcc GCC_GPLL0>;
		clock-names = "xo", "alternate";
		#interconnect-cells = <1>;
	};

	pmu@30091000 {
		compatible = "qcom,sc7280-llcc-bwmon";
		reg = <0x0 0x30091000 0x0 0x1000>;
		interrupts = <GIC_SPI 257 IRQ_TYPE_LEVEL_HIGH>;
		interconnects = <&mc_virt MASTER_LLCC QCOM_ICC_TAG_ACTIVE_ONLY
				&mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>;

		operating-points-v2 = <&llcc_bwmon_opp_table>;

		llcc_bwmon_opp_table: opp-table {
			compatible = "operating-points-v2";

			opp-0 {
				opp-peak-kBps = <2188800>;
			};

			opp-1 {
				opp-peak-kBps = <5414400>;
			};

			opp-2 {
				opp-peak-kBps = <6220800>;
			};

			opp-3 {
				opp-peak-kBps = <6835200>;
			};

			opp-4 {
				opp-peak-kBps = <8371200>;
			};

			opp-5 {
				opp-peak-kBps = <12748800>;
			};

			opp-6 {
				opp-peak-kBps = <14745600>;
			};

			opp-7 {
				opp-peak-kBps = <16896000>;
			};
		};
	};

	pmu@300B7400 {
		compatible = "qcom,sdm845-bwmon";
		reg = <0x0 0x300B7400 0x0 0x1000>;
		interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
		interconnects = <&gem_noc MASTER_APPSS_PROC 3 &gem_noc SLAVE_LLCC 3>;
		operating-points-v2 = <&cpu_bwmon_opp_table>;

		cpu_bwmon_opp_table: opp-table {
			compatible = "operating-points-v2";

			opp-0 {
				opp-peak-kBps = <5600000>;
			};

			opp-1 {
				opp-peak-kBps = <8528000>;
			};

			opp-2 {
				opp-peak-kBps = <14928000>;
			};

			opp-3 {
				opp-peak-kBps = <17216000>;
			};
		};
	};

	remoteproc_mpss: remoteproc@4000000 {
		compatible = "qcom,echo-mpss-pas";
		reg = <0x0 0x04000000 0x0 0x10000>;
		status = "ok";
		interrupts-extended = <&intc GIC_SPI 250 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog",
				  "fatal",
				  "ready",
				  "handover",
				  "stop-ack",
				  "shutdown-ack";
		clocks = <&rpmhcc RPMH_CXO_CLK>;
		clock-names = "xo";
		power-domains = <&rpmhpd RPMHPD_CX>, <&rpmhpd RPMHPD_MSS>;
		power-domain-names = "cx","mss";

		interconnects = <&mc_virt MASTER_LLCC 0 &mc_virt SLAVE_EBI1 0>;

		memory-region = <&mpss_mem>, <&q6_mpss_dtb_mem>,
				<&dsm_partition_1_mem>, <&dsm_partition_2_mem>,
				<&mpss_crashdump_overlay_mem>;

		qcom,qmp = <&aoss_qmp>;
		qcom,smem-states = <&modem_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		remoteproc_mpss_glink: glink-edge {
			qcom,remote-pid = <1>;
			transport = "smem";
			mboxes = <&ipcc_mproc IPCC_MPROC_MPSS
				  IPCC_MPROC_SIGNAL_GLINK_QMP>;
			mbox-names = "mpss_smem";
			interrupt-parent = <&ipcc_mproc>;
			interrupts = <IPCC_MPROC_MPSS
				      IPCC_MPROC_SIGNAL_GLINK_QMP
				      IRQ_TYPE_EDGE_RISING>;

			label = "modem";
			qcom,glink-label = "mpss";

			qcom,modem_qrtr {
				qcom,glink-channels = "IPCRTR";
				qcom,low-latency;
				qcom,intents = <0x800  5
						0x2000 3
						0x4400 2>;
			};

			qcom,modem_ds {
				qcom,glink-channels = "DS";
				qcom,intents = <0x4000 0x2>;
			};
		};
	};

	remoteproc_primess: primess@14400000 {
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		compatible = "qcom,echo-primess-pas";

		reg = <0x00 0x14400000 0x00 0xfe410>,
				<0x00 0x40000 0x00 0x10000>,
				<0x00 0x7f400 0x00 0x150>,
				<0x00 0x7f600 0x00 0x10c>,
				<0x00 0x80000 0x00 0x40000>;
		reg-names = "primess",
				"pdmem",
				"iu0-csr",
				"iuss-cmn",
				"mlmem";

		interrupts-extended = <&intc GIC_SPI 241 IRQ_TYPE_EDGE_RISING>,
					<&intc GIC_SPI 487 IRQ_TYPE_EDGE_RISING>,
					<&intc GIC_SPI 486 IRQ_TYPE_EDGE_RISING>,
					<&intc GIC_SPI 489 IRQ_TYPE_EDGE_RISING>,
					<&intc GIC_SPI 488 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog",
					"error",
					"boot-done",
					"task-done",
					"misc";

		clocks = <&gcc GCC_PRIME_CORE_CLK >;
		clock-names = "core-clk";

		interconnects = <&system_noc MASTER_PRIME_PROC QCOM_ICC_TAG_ACTIVE_ONLY
					&mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
					&system_noc SLAVE_PRIME QCOM_ICC_TAG_ACTIVE_ONLY>;
		interconnect-names = "prime-ddr","cpu-prime";

		memory-region = <&prime_mem>;

	};

	remoteproc_cdsp: remoteproc@26300000 {
		compatible = "qcom,echo-cdsp-pas";
		reg = <0x0 0x26300000 0x0 0x10000>;
		status = "ok";
		/* Inputs from turing */
		interrupts-extended = <&intc GIC_SPI 697 IRQ_TYPE_EDGE_RISING>,
				      <&cdsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&cdsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&cdsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&cdsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
				      <&cdsp_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog",
				  "fatal",
				  "ready",
				  "handover",
				  "stop-ack",
				  "shutdown-ack";
		clocks = <&rpmhcc RPMH_CXO_CLK>;
		clock-names = "xo";
		power-domains = <&rpmhpd RPMHPD_CX>, <&rpmhpd RPMHPD_MX>, <&rpmhpd RPMHPD_NSP>;
		power-domain-names = "cx","mx","nsp";

		interconnects = <&nsp_noc MASTER_CDSP_PROC 0 &mc_virt SLAVE_EBI1 0>;

		memory-region = <&cdsp_mem &q6_cdsp_dtb_mem>;
		qcom,qmp = <&aoss_qmp>;

		/* Outputs to turing */
		qcom,smem-states = <&cdsp_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		remoteproc_cdsp_glink: glink-edge {
			qcom,remote-pid = <5>;
			transport = "smem";
			mboxes = <&ipcc_mproc IPCC_MPROC_CDSP
				  IPCC_MPROC_SIGNAL_GLINK_QMP>;
			mbox-names = "cdsp_smem";
			interrupt-parent = <&ipcc_mproc>;
			interrupts = <IPCC_MPROC_CDSP
				      IPCC_MPROC_SIGNAL_GLINK_QMP
				      IRQ_TYPE_EDGE_RISING>;

			label = "cdsp";
			qcom,glink-label = "cdsp";

			qcom,cdsp_qrtr {
				qcom,glink-channels = "IPCRTR";
				qcom,intents = <0x800  5
						0x2000 3
						0x4400 2>;
			};

			fastrpc {
				compatible = "qcom,fastrpc";
				qcom,glink-channels = "fastrpcglink-apps-dsp";
				label = "cdsp";
				#address-cells = <1>;
				#size-cells = <0>;

				compute-cb@1 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <1>;
					iommus = <&apps_smmu 0x0C01 0x0000>;
					dma-coherent;
				};

				compute-cb@2 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <2>;
					iommus = <&apps_smmu 0x0C02 0x0000>;
					dma-coherent;
				};

				compute-cb@3 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <3>;
					iommus = <&apps_smmu 0x0C03 0x0000>;
					dma-coherent;
				};

				compute-cb@4 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <4>;
					iommus = <&apps_smmu 0x0C04 0x0000>;
					dma-coherent;
				};

				compute-cb@5 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <5>;
					iommus = <&apps_smmu 0x0C05 0x0000>;
					dma-coherent;
				};

				compute-cb@6 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <6>;
					iommus = <&apps_smmu 0x0C06 0x0000>;
					dma-coherent;
				};

				compute-cb@7 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <7>;
					iommus = <&apps_smmu 0x0C07 0x0000>;
					dma-coherent;
				};

				compute-cb@8 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <8>;
					iommus = <&apps_smmu 0x0C08 0x0000>;
					dma-coherent;
				};

				compute-cb@9 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <9>;
					iommus = <&apps_smmu 0x0C09 0x0000>;
					dma-coherent;
				};

				compute-cb@10 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <12>;
					iommus = <&apps_smmu 0x0C0C 0x0000>;
					dma-coherent;
				};

				compute-cb@11 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <13>;
					iommus = <&apps_smmu 0x0C0D 0x0000>;
					dma-coherent;
				};

				compute-cb@12 {
					compatible = "qcom,fastrpc-compute-cb";
					reg = <14>;
					iommus = <&apps_smmu 0x0C0E 0x0000>;
					dma-coherent;
				};
			};
		};
	};

	ipcc_mproc: qcom,ipcc@1104000 {
		compatible = "qcom,ipcc";
		reg = <0x0 0x1104000 0x0 0x1000>;
		interrupts = <GIC_SPI 691 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <3>;
		#mbox-cells = <2>;
		status = "ok";
	};

	wdog: qcom,wdt@17410000 {
		compatible ="qcom,msm-watchdog";
		reg = <0x0 0x17410000 0x0 0x1000>;
		reg-names = "wdt-base";
		interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
		qcom,bark-time = <11000>;
		qcom,pet-time = <9360>;
		qcom,ipi-ping;
		qcom,wakeup-enable;
		status = "ok";
	};

	qcom,chd {
		compatible = "qcom,core-hang-detect";
		label = "core";
		cluster-id = <0>;
		qcom,chd-percpu-info = <&CPU0 0x17800058 0x17800060>,
					<&CPU1 0x17810058 0x17810060>,
					<&CPU2 0x17820058 0x17820060>,
					<&CPU3 0x17830058 0x17830060>;
	};

	kryo_erp {
		compatible = "arm,arm64-kryo-cpu-erp";
