		polling-delay = <0>;
		thermal-sensors = <&tsens0 6>;
		trips {
			trip-point0 {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu_3_1_alert1: trip-point1 {
