&remoteproc_mpss {
	cooling {
		compatible = "qcom,qmi-cooling-modem";

		modem_pa_lte_dsc: modem_pa_lte_dsc {
			label = "pa_lte_dsc";
			#cooling-cells = <2>;
		};

		modem_pa_nr_mcg_dsc: modem_pa_nr_mcg_dsc {
			label = "pa_nr_mcg_dsc";
			#cooling-cells = <2>;
		};

		modem_pa_nr_scg_dsc: modem_pa_nr_scg_dsc {
			label = "pa_nr_scg_dsc";
			#cooling-cells = <2>;
		};

		modem_pa_lte_sub1_dsc: modem_pa_lte_sub1_dsc {
			label = "pa_lte_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_pa_nr_mcg_sub1_dsc: modem_pa_nr_mcg_sub1_dsc {
			label = "pa_nr_mcg_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_pa_nr_scg_sub1_dsc: modem_pa_nr_scg_sub1_dsc {
			label = "pa_nr_scg_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_fr1_mcg_dsc: modem_fr1_mcg_dsc {
			label = "modem_fr1_mcg_dsc";
			#cooling-cells = <2>;
		};

		modem_fr1_scg_dsc: modem_fr1_scg_dsc {
			label = "modem_fr1_scg_dsc";
			#cooling-cells = <2>;
		};

		modem_fr2_mcg_dsc: modem_fr2_mcg_dsc {
			label = "modem_fr2_mcg_dsc";
			#cooling-cells = <2>;
		};

		modem_fr2_scg_dsc: modem_fr2_scg_dsc {
			label = "modem_fr2_scg_dsc";
			#cooling-cells = <2>;
		};

		modem_fr1_mcg_sub1_dsc: modem_fr1_mcg_sub1_dsc {
			label = "modem_fr1_mcg_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_fr1_scg_sub1_dsc: modem_fr1_scg_sub1_dsc {
			label = "modem_fr1_scg_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_fr2_mcg_sub1_dsc: modem_fr2_mcg_sub1_dsc {
			label = "modem_fr2_mcg_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_fr2_scg_sub1_dsc: modem_fr2_scg_sub1_dsc {
			label = "modem_fr2_scg_sub1_dsc";
			#cooling-cells = <2>;
		};

		modem_current: modem_current {
			label = "modem";
			#cooling-cells = <2>;
		};

		modem_dsds_switch_dsc: modem_dsds_switch_dsc {
			label = "modem_dsds_switch_dsc";
			#cooling-cells = <2>;
		};
	};

	qmi_sensor: qmi-ts-sensors {
		compatible = "qcom,qmi-sensors";
		#thermal-sensor-cells = <1>;

		modem {
			qcom,instance-id = <QMI_MODEM_INST_ID>;
			qcom,qmi-sensor-names = "sdr0_pa",
						"sdr0",
						"mmw0";
		};
	};
};

&thermal_zones {
	sdr0_pa {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&qmi_sensor
				(QMI_MODEM_INST_ID+QMI_SDR0_PA)>;
		trips {
			trip-point0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	sdr0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&qmi_sensor
				(QMI_MODEM_INST_ID+QMI_SDR0)>;
		trips {
			trip-point0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

		};
	};

	mmw0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&qmi_sensor
				(QMI_MODEM_INST_ID+QMI_MMW0)>;
		trips {
			trip-point0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};
