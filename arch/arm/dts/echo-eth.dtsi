		};

		queue6 {
			snps,dcb-algorithm;
		};

		queue7 {
			snps,dcb-algorithm;
		};

		queue8 {
			snps,dcb-algorithm;
		};
	};

	emac2_mtl_tx_setup: emac2_tx-queues-config {
		snps,tx-queues-to-use = <9>;
		snps,tx-sched-sp;
		queue0 {
			snps,dcb-algorithm;
			qcom,ipa_offload;
			snps,queue_depth = <16384>;
		};

		queue1 {
			snps,dcb-algorithm;
		};

		queue2 {
			snps,dcb-algorithm;
		};

		queue3 {
			snps,dcb-algorithm;
		};

		queue4 {
			snps,dcb-algorithm;
		};

		queue5 {
			snps,dcb-algorithm;
		};

		queue6 {
			snps,dcb-algorithm;
		};

		queue7 {
			snps,dcb-algorithm;
		};

		queue8 {
			snps,dcb-algorithm;
		};
	};

	emac2_stmmac_axi_setup: emac2_stmmac-axi-config {
		snps,wr_osr_lmt = <15>;
		snps,rd_osr_lmt = <15>;
		snps,axi_kbbe;
		/* If FB is disabled, the AXI master chooses
		 * a burst length of any value less than the
		 * maximum enabled burst length
		 * (all lesser burst length enables are redundant).
		 */
		snps,blen = <0 0 0 0 0 0 0>;
		snps,tdps = <0x5>;
		snps,rdps = <0x5>;
	};

	emac2: qcom,emac2@0x22400000 {
		compatible = "qcom,echo-ethqos", "snps,dwxgmac";
		qcom,arm-smmu;
		dma-coherent;
		iommus = <&apps_smmu 0x1081 0x0>,
			 <&apps_smmu 0x1082 0x1>,
			 <&apps_smmu 0x1084 0x3>,
			 <&apps_smmu 0x1088 0x1>,
			 <&apps_smmu 0x108F 0x0>;
		reg = <0x0 0x22400000 0x0 0x12600>,
			<0x0 0x2247F000 0x0 0x1000>;
		reg-names = "stmmaceth", "rgmii";
		clocks =<&gcc GCC_EEE_EMAC2_CLK>,
			<&gcc GCC_EMAC2_AXI_CLK>,
			<&gcc GCC_EMAC2_PTP_CLK>,
			<&gcc GCC_EMAC2_RGMII_CLK>,
			<&gcc GCC_EMAC2_SLV_AHB_CLK>;
		clock-names = "eee", "stmmaceth", "ptp_ref", "rgmii",
		"pclk";
		power-domains = <&gcc GCC_EMAC2_GDSC>;
		interrupts = <GIC_SPI 599 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 597 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 596 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 595 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 594 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 593 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 592 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 591 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 590 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 589 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 574 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 573 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 572 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 571 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 570 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 569 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 568 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 567 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 566 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "macirq",
				  "dma_rx0",
				  "dma_rx1",
				  "dma_rx2",
				  "dma_rx3",
				  "dma_rx4",
				  "dma_rx5",
				  "dma_rx6",
				  "dma_rx7",
				  "dma_rx8",
				  "dma_tx0",
				  "dma_tx1",
				  "dma_tx2",
				  "dma_tx3",
				  "dma_tx4",
				  "dma_tx5",
				  "dma_tx6",
				  "dma_tx7",
				  "dma_tx8";
		snps,axi-config = <&emac2_stmmac_axi_setup>;
		pinctrl-names = "default","init";
		pinctrl-0 = <&emac2_mdc_active
			     &emac2_mdio_active
			     &emac2_pin_phy_intr_active
			     &emac2_phy_reset_state_active>;
		pinctrl-1 = <&emac2_mdc_inactive
			     &emac2_mdio_inactive
			     &emac2_pin_phy_intr_inactive
			     &emac2_phy_reset_state_inactive>;

		snps,tso;
		snps,pbl = <32>;
		tx-fifo-depth = <98304>;
		rx-fifo-depth = <98304>;
		snps,mtl-rx-config = <&emac2_mtl_rx_setup>;
		snps,mtl-tx-config = <&emac2_mtl_tx_setup>;

		interconnect-names = "emac-ddr", "emac-config";
		interconnects = <&system_noc MASTER_EMAC_2 0 &mc_virt SLAVE_EBI1 0>,
				<&gem_noc MASTER_APPSS_PROC 0 &system_noc SLAVE_ETH2_CFG 0>;
		operating-points-v2 = <&emac_opp_table>;

		status = "disabled";
		qcom-xpcs-handle = <&pcs2>;
		phys = <&serdes2>;
		phy-names = "serdes";

		emac2_mdio: emac2_mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};

	serdes0: serdes0@01D80000 {
		status = "disabled";
		compatible = "qcom,echo-serdes-phy";
		reg = <0x0 0x01D80000 0x0 0x1010>;
		reg-names = "serdes";
		clocks = <&tcsrcc TCSR_ETH_0_CLKREF_EN>,
			 <&gcc GCC_EMAC0_PHY_AUX_CLK>,
			 <&gcc GCC_EMAC0_SLV_AHB_CLK>,
			 <&gcc GCC_EMAC0_CC_SGMIIPHY_RX_CLK>,
			 <&gcc GCC_EMAC0_CC_SGMIIPHY_TX_CLK>;
		clock-names = "sgmi_ref", "phyaux", "pclk",
		"sgmii_rx", "sgmii_tx";
		power-domains = <&gcc GCC_EMAC0_GDSC>;
		vreg_1p2-supply = <&vreg_l1b_1p2>;
		vreg_0p9-supply = <&vreg_l4b_0p8>;
		#phy-cells = <0>;
	};

	serdes1: serdes1@01D90000 {
		status = "disabled";
		compatible = "qcom,echo-serdes-phy";
		reg = <0x0 0x01D90000 0x0 0x1010>;
		reg-names = "serdes";
		clocks = <&tcsrcc TCSR_ETH_1_CLKREF_EN>,
			 <&gcc GCC_EMAC1_PHY_AUX_CLK>,
			 <&gcc GCC_EMAC1_SLV_AHB_CLK>,
			 <&gcc GCC_EMAC1_CC_SGMIIPHY_RX_CLK>,
			 <&gcc GCC_EMAC1_CC_SGMIIPHY_TX_CLK>;
		clock-names = "sgmi_ref", "phyaux", "pclk",
		"sgmii_rx", "sgmii_tx";
		power-domains = <&gcc GCC_EMAC1_GDSC>;
		vreg_1p2-supply = <&vreg_l1b_1p2>;
		vreg_0p9-supply = <&vreg_l4b_0p8>;
		#phy-cells = <0>;
	};

	serdes2: serdes2@01DA0000 {
		status = "disabled";
		compatible = "qcom,echo-serdes-phy";
		reg = <0x0 0x01DA0000 0x0 0x1010>;
		reg-names = "serdes";
		clocks = <&tcsrcc TCSR_ETH_2_CLKREF_EN>,
			 <&gcc GCC_EMAC2_PHY_AUX_CLK>,
			 <&gcc GCC_EMAC2_SLV_AHB_CLK>,
			 <&gcc GCC_EMAC2_CC_SGMIIPHY_RX_CLK>,
			 <&gcc GCC_EMAC2_CC_SGMIIPHY_TX_CLK>;
		clock-names = "sgmi_ref", "phyaux", "pclk",
		"sgmii_rx", "sgmii_tx";
		power-domains = <&gcc GCC_EMAC2_GDSC>;
		vreg_1p2-supply = <&vreg_l1b_1p2>;
		vreg_0p9-supply = <&vreg_l4b_0p8>;
		#phy-cells = <0>;
	};

	pcs0: pcs0@22314000 {
		status = "disabled";
		compatible = "qcom,xpcs";
		reg = <0x0 0x22314000 0x0 0x5100>;
		reg-names = "qxpcs";
		clocks = <&gcc GCC_EMAC0_RPCS_RX_CLK>,
			<&gcc GCC_EMAC0_RPCS_TX_CLK>,
			<&gcc GCC_EMAC0_XGXS_RX_CLK>,
			<&gcc GCC_EMAC0_XGXS_TX_CLK>,
			<&gcc GCC_EMAC0_SLV_AHB_CLK>;
		clock-names = "rpcs_rx", "rpcs_tx", "xgxs_rx", "xgxs_tx", "pclk";
		power-domains = <&gcc GCC_EMAC0_GDSC>;
		interrupts = <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pcs_intr";
	};

	pcs1: pcs1@22394000 {
		status = "disabled";
		compatible = "qcom,xpcs";
		reg = <0x0 0x22394000 0x0 0x5100>;
		reg-names = "qxpcs";
		clocks = <&gcc GCC_EMAC1_RPCS_RX_CLK>,
			<&gcc GCC_EMAC1_RPCS_TX_CLK>,
			<&gcc GCC_EMAC1_XGXS_RX_CLK>,
			<&gcc GCC_EMAC1_XGXS_TX_CLK>,
			<&gcc GCC_EMAC1_SLV_AHB_CLK>;
		clock-names = "rpcs_rx", "rpcs_tx", "xgxs_rx", "xgxs_tx", "pclk";
		power-domains = <&gcc GCC_EMAC1_GDSC>;
		interrupts = <GIC_SPI 418 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pcs_intr";
	};

	pcs2: pcs2@22414000 {
		status = "disabled";
		compatible = "qcom,xpcs";
		reg = <0x0 0x22414000 0x0 0x5100>;
		reg-names = "qxpcs";
		clocks = <&gcc GCC_EMAC2_RPCS_RX_CLK>,
			<&gcc GCC_EMAC2_RPCS_TX_CLK>,
			<&gcc GCC_EMAC2_XGXS_RX_CLK>,
			<&gcc GCC_EMAC2_XGXS_TX_CLK>,
			<&gcc GCC_EMAC2_SLV_AHB_CLK>;
		clock-names = "rpcs_rx", "rpcs_tx", "xgxs_rx", "xgxs_tx", "pclk";
		power-domains = <&gcc GCC_EMAC2_GDSC>;
		interrupts = <GIC_SPI 598 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pcs_intr";
	};
};
